{
  "rules": {
    "esphub": {
      ".read": true,
      "$spiel": {
        ".validate": "$spiel.matches(/^[A-Za-z0-9_]{1,40}$/)",
        "boards": {
          "$board": {
            ".write": "$board.matches(/^[0-9a-f]{12}$/)"
          }
        },
        "global": {
          ".write": true
        },
        "listen": {
          "$liste": {
            "$board": {
              ".write": "$board.matches(/^[0-9a-f]{12}$/)",
              ".validate": "newData.child('p').isNumber() && newData.child('n').isString() && newData.child('n').val().length <= 10"
            }
          }
        }
      }
    }
  }
}
